<?xml version="1.0"?>
<!--
	Runs the same suite against a multisite network.

	WP_TESTS_MULTISITE is read by the WordPress test bootstrap, and constants
	declared here are defined before that bootstrap runs.

	Lives under tests/ rather than beside phpunit.xml.dist because
	plugin_deploy.sh excludes 'phpunit.xml.dist' by exact name, not by glob, so
	a sibling config would ship to users. Paths are relative to this file.
-->
<phpunit
	bootstrap="bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1"/>
	</php>
	<testsuites>
		<testsuite name="wp-postratings">
			<directory suffix=".php">./</directory>
			<exclude>./bootstrap.php</exclude>
			<exclude>./class-wp-postratings-testcase.php</exclude>
			<exclude>./index.php</exclude>
		</testsuite>
	</testsuites>
</phpunit>
