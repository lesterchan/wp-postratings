vendor/
node_modules/
.idea/
.phpunit.result.cache
.wp-env.override.json

# Playwright traces and screenshots from a failing run. The configured output
# directory is the first; the second is where Playwright puts them when it is
# run with any other config, which is how two of them once reached a commit.
artifacts/
test-results/

# Compiled block sources. Generated from src/ by bin/build, which the deploy
# runs before it copies anything -- so this being absent from a fresh clone is
# correct, and build/ is deliberately *not* excluded from the deploy the way
# src/ is: it is what register_block_type_from_metadata() loads at runtime.
build/
